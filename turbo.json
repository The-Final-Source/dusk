{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DUSK_RUN_CORRECTNESS"],
      "passThroughEnv": ["DUSK_RUN_CORRECTNESS", "DUSK_VERIFIER_MODEL", "ANTHROPIC_API_KEY"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:seed": {
      "cache": false
    }
  }
}
