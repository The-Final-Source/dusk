      },
      { "id": "alerts", "type": "ellipse", "x": 980, "y": 560, "width": 220, "height": 100, "label": "Alerts queue" },
      { "type": "arrow", "start": { "id": "src" }, "end": { "id": "parse" }, "label": "JSON" },
      { "type": "arrow", "start": { "id": "parse" }, "end": { "id": "enrich" }, "label": "event" },
      { "type": "arrow", "start": { "id": "enrich" }, "end": { "id": "warehouse" }, "label": "row" },
