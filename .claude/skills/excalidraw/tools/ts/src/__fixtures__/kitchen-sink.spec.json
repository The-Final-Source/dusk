{
  "$$primitiveVersion": 1,
  "viewport": { "width": 1600, "height": 900 },
  "background": "#FFFFFF",
  "elements": [
    {
      "type": "text",
      "x": 60,
      "y": 40,
      "text": "Kitchen Sink — Every Primitive",
      "fontSize": 28,
      "strokeColor": "#1E1E1E"
    },
    {
      "type": "text",
      "x": 60,
      "y": 90,
      "text": "Title above. Three shapes connected by arrows. Two free-floating text blocks. A frame around the chain. A freedraw underline. A dashed footer line.",
      "fontSize": 16,
      "width": 1480,
      "strokeColor": "#555555"
    },

    {
      "type": "rectangle",
      "id": "ingest",
      "x": 120,
      "y": 240,
      "width": 240,
      "height": 120,
      "strokeColor": "#1E4B8C",
      "backgroundColor": "#E0E8F2",
      "label": { "text": "Ingest", "fontSize": 22 }
    },
    {
      "type": "ellipse",
      "id": "process",
      "x": 540,
      "y": 240,
      "width": 240,
      "height": 120,
      "strokeColor": "#7B4CC4",
      "backgroundColor": "#EEDFFA",
      "label": { "text": "Process", "fontSize": 22 }
    },
    {
      "type": "diamond",
      "id": "decide",
      "x": 960,
      "y": 240,
      "width": 280,
      "height": 140,
      "strokeColor": "#7A5C00",
      "backgroundColor": "#FFF3C7",
      "label": { "text": "Above Threshold?", "fontSize": 20 }
    },

    {
      "type": "arrow",
      "id": "e1",
      "from": "ingest",
      "to": "process",
      "label": "raw event",
      "strokeColor": "#444444"
    },
    {
      "type": "arrow",
      "id": "e2",
      "from": "process",
      "to": "decide",
      "label": "score",
      "strokeColor": "#444444"
    },

    {
      "type": "rectangle",
      "id": "publish",
      "x": 1320,
      "y": 160,
      "width": 220,
      "height": 100,
      "strokeColor": "#1E4B8C",
      "backgroundColor": "#E0E8F2",
      "label": { "text": "Publish", "fontSize": 20 }
    },
    {
      "type": "rectangle",
      "id": "drop",
      "x": 1320,
      "y": 360,
      "width": 220,
      "height": 100,
      "strokeColor": "#9B2C2C",
      "backgroundColor": "#FDE8E8",
      "label": { "text": "Drop", "fontSize": 20 }
    },
    {
      "type": "arrow",
      "id": "e3",
      "from": "decide",
      "to": "publish",
      "label": "yes",
      "strokeColor": "#2F855A"
    },
    {
      "type": "arrow",
      "id": "e4",
      "from": "decide",
      "to": "drop",
      "label": "no",
      "strokeColor": "#9B2C2C"
    },

    {
      "type": "frame",
      "id": "frame-cold-path",
      "label": "Cold Path",
      "children": ["ingest", "process", "decide", "publish", "drop"],
      "padding": 40
    },

    {
      "type": "freedraw",
      "x": 60,
      "y": 720,
      "points": [
        [0, 0],
        [40, 2],
        [120, -3],
        [220, 1],
        [340, 4],
        [460, -2],
        [600, 0]
      ],
      "strokeColor": "#1E1E1E",
      "strokeWidth": 3
    },
    {
      "type": "text",
      "x": 60,
      "y": 760,
      "text": "Freedraw stroke above; ad-hoc hand-drawn primitive.",
      "fontSize": 14,
      "strokeColor": "#666666"
    },

    {
      "type": "line",
      "from": { "x": 60, "y": 820 },
      "to": { "x": 1540, "y": 820 },
      "strokeColor": "#CCCCCC",
      "strokeStyle": "dashed"
    },
    {
      "type": "text",
      "x": 60,
      "y": 835,
      "text": "Footer line above (type: line, no arrowheads). Generated by the primitive pipeline.",
      "fontSize": 12,
      "strokeColor": "#888888"
    }
  ]
}
