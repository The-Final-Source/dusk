    {
      "id": "LP7cH1Z34CM_E5zAiEYbn",
      "type": "text",
      "x": 86.2109375,
      "y": 7866.2109375,
      "width": 247.458984375,
      "height": 552,
      "angle": 0,
      "strokeColor": "#1F2E4D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6E",
