      "isDeleted": false,
      "boundElements": [],
      "updated": 1781010843456,
      "link": null,
      "locked": false,
      "text": "Step 2 — Bead Decomp + Sequencing\nbuild DAG · file-overlap edges · cross-bead focal-claim\noverlap = HARD refusal (decomposer_bead_conflict) ·\nsupport-claim overlap = warning · independent → parallel",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "s2",
      "originalText": "Step 2 — Bead Decomp + Sequencing\nbuild DAG · file-overlap edges · cross-bead focal-claim\noverlap = HARD refusal (decomposer_bead_conflict) ·\nsupport-claim overlap = warning · independent → parallel",
      "autoResize": true,
      "lineHeight": 1.15
    },
