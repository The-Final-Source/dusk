    {
      "id": "OyVInoJlAMI08uT5I9lOz",
      "type": "text",
      "x": 3945.951918523263,
      "y": 721.388635630313,
      "width": 303.20361328125,
      "height": 50.599999999999994,
      "angle": 0,
      "strokeColor": "#2E4A3A",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3o",
      "roundness": null,
      "seed": 735358237,
      "version": 169,
      "versionNonce": 541553837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781010843456,
      "link": null,
      "locked": false,
      "text": "Step 1 — Request Decomposition\nRoot builds SESSION SNAPSHOT INDEX (immutable for run)\nDecomposer walks typed relates_to (5 kinds: parent / implies\n/ conflicts / supersedes / sibling) + test-pyramid children",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "s1",
      "originalText": "Step 1 — Request Decomposition\nRoot builds SESSION SNAPSHOT INDEX (immutable for run)\nDecomposer walks typed relates_to (5 kinds: parent / implies\n/ conflicts / supersedes / sibling) + test-pyramid children",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "xa42Sn3DuG94dZTLgF7l9",
      "type": "text",
      "x": 3996.505873601388,
      "y": 897.488635630313,
      "width": 202.095703125,
      "height": 110.39999999999999,
      "angle": 0,
      "strokeColor": "#2E4A3A",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3p",
      "roundness": null,
      "seed": 995919421,
      "version": 169,
      "versionNonce": 2053355469,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781010843456,
      "link": null,
      "locked": false,
      "text": "Any unresolved\nintent reference?\n(if yes → write checkpoint;\nreturn DuskError{kind:\nimplement_paused_for_authoring,\nresume_token}; harness drives\ndusk_author_* dialog; resume\nvia dusk_implement({resume_token}))",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "s1-newintent",
      "originalText": "Any unresolved\nintent reference?\n(if yes → write checkpoint;\nreturn DuskError{kind:\nimplement_paused_for_authoring,\nresume_token}; harness drives\ndusk_author_* dialog; resume\nvia dusk_implement({resume_token}))",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "47M29HX--nxwR5CQrvMKL",
      "type": "text",
      "x": 3958.294691960763,
      "y": 1251.3990695637547,
      "width": 278.51806640625,
      "height": 50.599999999999994,
      "angle": 0,
      "strokeColor": "#2E4A3A",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3q",
